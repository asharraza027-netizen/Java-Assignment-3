import java.util.Random;
import java.util.Scanner;

// Thread to compute the square of an even number
class SquareCalculator extends Thread {
    private int number;

    public SquareCalculator(int number) {
        this.number = number;
    }

    @Override
    public void run() {
        System.out.println("Square: " + (number * number));
    }
}

// Thread to compute the cube of an odd number
class CubeCalculator extends Thread {
    private int number;

    public CubeCalculator(int number) {
        this.number = number;
    }

    @Override
    public void run() {
        System.out.println("Cube: " + (number * number * number));
    }
}

// Thread to generate random numbers every second
class RandomNumberGenerator extends Thread {
    private volatile boolean running = true;
    private Random random = new Random();

    public void stopSimulation() {
        running = false;
        this.interrupt();
    }

    @Override
    public void run() {
        while (running) {
            // Generate a random integer between 1 and 20
            int num = random.nextInt(20) + 1;
            System.out.println("Generated: " + num);

            if (num % 2 == 0) {
                SquareCalculator squareThread = new SquareCalculator(num);
                squareThread.start();
                try {
                    squareThread.join(); // Ensure output sequence is preserved
                } catch (InterruptedException e) {
                    break;
                }
            } else {
                CubeCalculator cubeThread = new CubeCalculator(num);
                cubeThread.start();
                try {
                    cubeThread.join(); // Ensure output sequence is preserved
                } catch (InterruptedException e) {
                    break;
                }
            }

            try {
                // Pause for 1 second before generating the next reading
                Thread.sleep(1000);
            } catch (InterruptedException e) {
                break;
            }
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Menu:");
        System.out.println("1. Start Simulation");
        System.out.println("2. Exit");
        System.out.print("Enter choice: ");

        int choice = scanner.nextInt();

        if (choice == 1) {
            RandomNumberGenerator generator = new RandomNumberGenerator();
            generator.start();

            // Run simulation, or press Enter/type to terminate gracefully if needed
            System.out.println("(Press Enter in the console to stop simulation at any time)");
            scanner.nextLine(); // Consume newline
            scanner.nextLine(); // Wait for user enter to stop

            generator.stopSimulation();
            try {
                generator.join();
            } catch (InterruptedException e) {
                System.out.println("Simulation interrupted.");
            }
            System.out.println("Simulation stopped.");
        } else {
            System.out.println("Exiting system.");
        }

        scanner.close();
    }
}
